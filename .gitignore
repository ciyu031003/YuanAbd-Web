# 设计草稿与生成工具产物（非站点源码）
.threeui/
gui-test-screenshots/

# 部署备份文件 —— 版本管理走 git，不留 .bak
demo/*.bak*
demo/js/*.bak*
demo/css/*.bak*
demo/js/**/*.bak*

# 系统文件
Thumbs.db
.DS_Store

# 本地回归校验产物（截图 / 计算样式探针，仅本地用）
.tmp-shots/
.tmp-sop/
.tmp-3d/
# 修盒子部署产物（由 deploy-fixboxs.cjs 生成，部署用；不入库）
dist/
dist-fixboxs.tgz

# 设计文档（本地保留，不入库 —— 按项目负责人要求）
docs/

# 后台服务依赖（lockfile 入库、node_modules 不入库）
admin/node_modules/

# 后台真实环境变量（含数据库密码等密钥，绝不入库）
admin/admin.env
*.env
!admin/admin.env.example
