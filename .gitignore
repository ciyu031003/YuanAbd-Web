# 设计草稿与生成工具产物（非站点源码）
.threeui/
gui-test-screenshots/

# 部署备份文件 —— 版本管理走 git，不留 .bak
demo/*.bak*
demo/js/*.bak*
demo/css/*.bak*
demo/js/**/*.bak*

# 系统文件
Thumbs.db
.DS_Store

# 本地回归校验产物（截图 / 计算样式探针，仅本地用）
.tmp-shots/
.tmp-sop/
.tmp-3d/
# 修盒子部署产物（由 deploy-fixboxs.cjs 生成，部署用；不入库）
dist/
dist-fixboxs.tgz

# 设计文档（本地保留，不入库 —— 按项目负责人要求）
docs/

# 后台服务依赖（lockfile 入库、node_modules 不入库）
admin/node_modules/

# 后台真实环境变量（含数据库密码等密钥，绝不入库）
admin/admin.env
*.env
!admin/admin.env.example

# 媒体库上传（2026-10-24 起不入库）
# 后台上传的图片落在 demo/fixboxs/media/，属于「运行时数据」而非源码：
#   · 上线路径是发布产物（deploy-fixboxs.cjs 整体复制 demo/fixboxs → dist/fixboxs → tar → 原子切换），
#     不依赖 git 传输；
#   · 入库曾导致服务器仓库每次上传后与 GitHub 分叉（fixboxs-content-commit.sh 只 add content/，
#     媒体文件游离在工作区，一旦有人 git add -A / reset 就出问题）；
#   · 元数据（alt/上传者/哈希）在 DB media 表，文件丢失可在媒体库里被发现。
demo/fixboxs/media/
