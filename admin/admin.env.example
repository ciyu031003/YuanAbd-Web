# admin.env.example — 后台环境变量模板
# 部署时复制为 /srv/fixboxs/admin.env 并填入真实值；该文件权限应为 600，属主 ubuntu。
# 仓库里不保存任何真实密钥。

# ---- 数据库（独立库 + 专用最小权限角色） ----
DB_PASSWORD=__REPLACE_ME__

# ---- 会话 ----
# 生产必须 true（后台走 HTTPS）
SESSION_SECURE=true

# ---- 后台公网地址（用于生成一次性激活链接） ----
# 实际使用的域名是 dashboard.pc-fixboxs.yuanabd.cn（非 admin）
ADMIN_PUBLIC_URL=https://dashboard.pc-fixboxs.yuanabd.cn

# ---- 发布 ----
PUBLISH_ENABLED=true
# 是否把内容提交推送到 GitHub 作为异地备份（失败不阻塞发布）
PUBLISH_PUSH=false
GIT_AUTHOR_NAME=fixboxs-admin
GIT_AUTHOR_EMAIL=admin@yuanabd.cn

# ---- 安全 ----
LOGIN_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=12
TRUST_PROXY=true
